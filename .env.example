NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon keys are also supported. Use only one key below/above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meezan Bank E-Commerce Gateway. Add only to .env.local and deployment secrets;
# never expose these through NEXT_PUBLIC_ variables or commit them to Git.
MEEZAN_GATEWAY_MODE=staging
MEEZAN_MERCHANT_ID=
MEEZAN_GATEWAY_URL=
MEEZAN_GATEWAY_API_KEY=
MEEZAN_GATEWAY_API_SECRET=
MEEZAN_RETURN_URL=http://localhost:3000/api/payments/meezan/return
MEEZAN_WEBHOOK_SECRET=
